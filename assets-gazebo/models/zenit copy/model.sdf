<?xml version='1.0'?>
<sdf version='1.9'>
  <model name="grass-amb-cam-copy">

    <include>
      <uri>model://grasshopper</uri>
    </include>

    <link name="camera_link">
      <pose>0 -0.05 0 0 90 0</pose>
      <visual name="camera_body">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      <sensor name="camera" type="camera">
        <pose degrees="true"> 0 -0.05 0 0 90 0</pose>
        
        <camera>
          <vertical_fov>1.1693</vertical_fov>
          <horizontal_fov>1.7802</horizontal_fov>
          <image>
            <width>1536</width>
            <height>864</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>

        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>1</visualize>

        <plugin name="GstCameraPlugin" 
            filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5600</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>

      </sensor>
    </link>

    <joint name="camera_mount" type="fixed">
      <parent>grasshopper::base_link</parent>
      <child>camera_link</child>
    </joint>

    <link name="camera_link2">
      <pose>0 0.05 0 0 90 0</pose>
      <visual name="camera_body2">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      <sensor name="camera2" type="camera">
        <pose degrees="true"> 0 0.05 0 0 90 0</pose>
        
        <camera>
          <vertical_fov>0.8517</vertical_fov>
          <horizontal_fov>1.0856</horizontal_fov>
          <image>
            <width>1640</width>
            <height>1232</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>

        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>1</visualize>

        <plugin name="GstCameraPlugin" 
            filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5700</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>

      </sensor>
    </link>

    <joint name="camera_mount2" type="fixed">
      <parent>grasshopper::base_link</parent>
      <child>camera_link2</child>
    </joint>

  </model>
</sdf>
